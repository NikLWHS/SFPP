            "user": "U036YAYMM",
            "ts": "1645809374.000000"
        },
        "client_msg_id": "6673ef3b-5cc5-422d-bd84-b6ac48ac3cbd",
        "text": "FYI, let’s try to keep back-and-forth on this channel to a minimum — it’s primarily a repository for recording items we can compile later for reports and such. Let’s either thread commentary under those items or move them to another channel so the main postings are easier to find. Thx.",
        "team": "T036YAYMK",
        "user_team": "T036YAYMK",
        "source_team": "T036YAYMK",
        "user_profile": {
            "avatar_hash": "a8915bfb0098",
            "image_72": "https:\/\/avatars.slack-edge.com\/2018-02-01\/308107995713_a8915bfb00981894f216_72.png",
            "first_name": "mstoll",
