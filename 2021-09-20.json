    {
        "user": "UFEH6KZU7",
        "type": "message",
        "ts": "1632174521.016100",
        "client_msg_id": "8AADC3EB-637A-43BA-B12B-D4531CD31F1C",
        "text": "My point was that people tend to relax when it seems like a casual conversation. ‘Hey, Noah, great story. By the way, how did you get the info?’ If you’re talking to a journalist outside your own organization, you should be vigilant of the possibility that they might be working you and respond accordingly. ",
        "team": "T036YAYMK",
        "user_team": "T036YAYMK",
        "source_team": "T036YAYMK",
        "user_profile": {
