    {
        "user": "U036YAYMM",
        "type": "message",
        "ts": "1658434115.259019",
        "client_msg_id": "ed1be1a4-688f-48fb-95d0-61eef6b271cf",
        "text": "Yes, there seems to be a plague of fake news sites stealing content from publishers, and this accelerated when we started working with the LA Times (which they probably scrape more frequently). I’ve made our contact there aware of it, but there are so many of these things that it’s impossible to police unless the search engines get engaged and help by delisting them.\nThis from their laughable about page:\n*“News Pub is one of the best news portals online dedicated to providing our readers with the latest news from all around the world. Please fill out the form below to get in touch with us and we will get back to you as soon as possible.”*",
        "team": "T036YAYMK",
        "user_team": "T036YAYMK",
        "source_team": "T036YAYMK",
        "user_profile": {
            "avatar_hash": "a8915bfb0098",
            "image_72": "https:\/\/avatars.slack-edge.com\/2018-02-01\/308107995713_a8915bfb00981894f216_72.png",
            "first_name": "mstoll",
            "real_name": "mstoll",
            "display_name": "Michael Stoll",
            "team": "T036YAYMK",
            "name": "mstoll",
            "is_restricted": false,
            "is_ultra_restricted": false
        },
        "blocks": [
            {
                "type": "rich_text",
                "block_id": "QFXof",
                "elements": [
                    {
                        "type": "rich_text_section",
                        "elements": [
                            {
                                "type": "text",
                                "text": "Yes, there seems to be a plague of fake news sites stealing content from publishers, and this accelerated when we started working with the LA Times (which they probably scrape more frequently). I’ve made our contact there aware of it, but there are so many of these things that it’s impossible to police unless the search engines get engaged and help by delisting them.\nThis from their laughable about page:\n"
                            },
                            {
                                "type": "text",
                                "text": "“News Pub is one of the best news portals online dedicated to providing our readers with the latest news from all around the world. Please fill out the form below to get in touch with us and we will get back to you as soon as possible.”",
                                "style": {
                                    "bold": true
                                }
                            }
                        ]
                    }
                ]
            }
