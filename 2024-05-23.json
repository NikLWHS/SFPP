    {
        "user": "U01PU2BUHU5",
        "type": "message",
        "ts": "1716497333.268699",
        "client_msg_id": "943c326c-f82e-4452-bd37-296993d6a140",
        "text": "CatchLight sent me some feedback on the talk in case you would like to use it for anything Lisa. See comments below from some of the guests:\n\n&gt; _\"Yesica's phenomenal presentation was special in all the right ways. Her work is a perfect case study on the importance of local visual journalism, and its deeply tangible value that shows up in community relationships and even the aesthetic approach to image making. She was also clearly very well prepared to deliver an outstanding, engaging talk.\"_\n&gt; _\"I loved the way Yesica wove her own story and experiences into the narrative, showing how they informed the approach she took with her reporting. The presentation also had incredible editing and managed to show how a story can be candid about the challenges of living in encampments in the Bay while preserving the dignity and personhood of the people featured.\"_",
        "team": "T036YAYMK",
        "user_team": "T036YAYMK",
        "source_team": "T036YAYMK",
        "user_profile": {
            "avatar_hash": "4b581a111d3f",
            "image_72": "https:\/\/avatars.slack-edge.com\/2021-03-29\/1914862454420_4b581a111d3f68c33ec2_72.jpg",
            "first_name": "Yesica",
            "real_name": "Yesica Prado",
            "display_name": "Yesica Prado",
            "team": "T036YAYMK",
            "name": "yesica.prado13",
            "is_restricted": false,
            "is_ultra_restricted": false
        },
        "thread_ts": "1716487561.316279",
        "parent_user_id": "U02LAK62DEV",
        "blocks": [
            {
                "type": "rich_text",
                "block_id": "DF0Hy",
                "elements": [
                    {
                        "type": "rich_text_section",
                        "elements": [
                            {
                                "type": "text",
                                "text": "CatchLight sent me some feedback on the talk in case you would like to use it for anything Lisa. See comments below from some of the guests:\n\n"
                            }
                        ]
                    },
                    {
                        "type": "rich_text_quote",
                        "elements": [
                            {
                                "type": "text",
                                "text": "\"Yesica's phenomenal presentation was special in all the right ways. Her work is a perfect case study on the importance of local visual journalism, and its deeply tangible value that shows up in community relationships and even the aesthetic approach to image making. She was also clearly very well prepared to deliver an outstanding, engaging talk.\"",
                                "style": {
                                    "italic": true
                                }
                            }
                        ]
                    },
                    {
                        "type": "rich_text_section",
                        "elements": [
                            {
                                "type": "text",
                                "text": "\n"
                            }
                        ]
                    },
                    {
                        "type": "rich_text_quote",
                        "elements": [
                            {
                                "type": "text",
                                "text": "\"I loved the way Yesica wove her own story and experiences into the narrative, showing how they informed the approach she took with her reporting. The presentation also had incredible editing and managed to show how a story can be candid about the challenges of living in encampments in the Bay while preserving the dignity and personhood of the people featured.\"",
                                "style": {
                                    "italic": true
                                }
                            }
                        ]
                    }
                ]
            }
        ],
