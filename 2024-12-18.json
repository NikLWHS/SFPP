    {
        "user": "U036YAYMM",
        "type": "message",
        "ts": "1734544913.403609",
        "client_msg_id": "DE3C2B24-F72A-465A-A221-C6B677C3F22E",
        "text": "I thought it was over all pretty balanced. Remember this is going to be news to 95% of listeners, that there’s even a problem there. I think Chris was appropriately careful not to cause a panic based on our limited reporting to say that everyone should move out of the neighborhood because of a threat that is basically unknowable. That said, the fact of doing the reporting and the interview implicitly highlighted the need for accountability. It was we who interviewed the Navy in the first place, and got them to admit a lot went wrong in the past and continues to be a problem.",
        "team": "T036YAYMK",
        "user_team": "T036YAYMK",
        "source_team": "T036YAYMK",
        "user_profile": {
            "avatar_hash": "a8915bfb0098",
